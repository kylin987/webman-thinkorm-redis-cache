{
  "name": "kylin987/webman-thinkorm-redis-cache",
  "description": "适用于webman下基于think-orm和redis开发的跨项目共享cache",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "kylin87",
      "email": "kylin87@qq.com"
    }
  ],
  "require": {
    "php": ">=8.1",
    "symfony/cache": "^6.2 || ^7.0",
    "psr/container": "^1.1.1 || ^2.0",
    "webman/think-orm": "^1.1 || ^2.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Kylin987\\ThinkOrm\\RedisCache\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kylin987\\ThinkOrm\\RedisCache\\Tests\\": "tests/"
    },
    "files": [
      "tests/Support/Redis.php"
    ]
  }
}
